  "title": "Partners",
  "type": "object",
  "required": [
    "items"
  ],
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string"
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name",
          "kind"
        ],
        "additionalProperties": false,
        "properties": {
          "name": {
            "$ref": "common.schema.json#/$defs/localized"
          },
          "kind": {
            "$ref": "common.schema.json#/$defs/localized"
          },
          "url": {
            "type": "string"
          }
        }
      }
    }
  }
}
